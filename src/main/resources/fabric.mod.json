{
	"schemaVersion": 1,
	"id": "codec2schema",
	"version": "${version}",
	"name": "Codec2Schema",
	"description": "A tool to convert codecs to JSON schemas.",
	"authors": [
		"Tr100000"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/codec2schema",
		"sources": "https://github.com/Tr100000/Codec2Schema",
    "issues": "https://github.com/Tr100000/Codec2Schema/issues"
	},
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
    "codec2schema:main": [
			"io.github.tr100000.codec2schema.Codec2SchemaCommonPlugin",
			"io.github.tr100000.codec2schema.Codec2SchemaConfigPlugin",
			"io.github.tr100000.codec2schema.compat.fabric.FabricCompat",
			"io.github.tr100000.codec2schema.compat.trutils.TrUtilsCompat"
		],
		"codec2schema:client": [
      "io.github.tr100000.codec2schema.Codec2SchemaClientPlugin",
			"io.github.tr100000.codec2schema.compat.fabric.FabricCompatClient"
		]
	},
	"mixins": [
		"codec2schema.mixins.json",
		{
			"config": "codec2schema.client.mixins.json",
			"environment": "client"
		}
	],
  "accessWidener": "codec2schema.classtweaker",
	"depends": {
		"fabricloader": ">=0.19",
		"minecraft": "~26.3-",
		"java": ">=25"
	}
}
